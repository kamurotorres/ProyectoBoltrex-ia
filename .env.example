# Boltrex — variables de Docker Compose (copiar a `.env` en esta misma carpeta). Backlog P2.25.
#   cp .env.example .env    y reemplazar TODOS los valores <...>
# Generar contraseñas (solo letras y números, porque van dentro de una URL):
#   python3 -c "import secrets; print(secrets.token_hex(24))"

# --- MongoDB (obligatorias) ---
# Administrador de Mongo: solo para crear usuarios, respaldos y restauraciones.
MONGO_ROOT_USER=boltrex_root
MONGO_ROOT_PASSWORD=<contraseña-larga-alfanumérica>
# Usuario de la aplicación: el backend se conecta con él (solo lee/escribe su base).
MONGO_APP_USER=boltrex_app
MONGO_APP_PASSWORD=<otra-contraseña-larga-alfanumérica>
DB_NAME=boltrex

# --- Solo producción (docker-compose.prod.yml) ---
# Dominio con un registro DNS tipo A apuntando a la IP del VPS.
DOMAIN=boltrex.online
# Correo para avisos de Let's Encrypt (vencimientos de certificado).
ACME_EMAIL=<tu-correo>
TZ=America/Bogota
# Respaldos: hora diaria (0-23, en TZ) y días que se conservan en el VPS.
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
# Copia fuera del VPS (Google Drive con rclone). Vacío = sin copia externa.
RCLONE_REMOTE=gdrive:boltrex-backups
RCLONE_KEEP_DAYS=30

# --- Opcionales (límites de memoria; valores para un VPS de 8 GB) ---
# MONGO_CACHE_GB=1
# MONGO_MEM_LIMIT=2g
# BACKEND_MEM_LIMIT=1g
# FRONTEND_MEM_LIMIT=256m
# HTTP_PORT=80
# HTTPS_PORT=443
