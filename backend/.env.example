# Boltrex — variables del backend (copiar a `backend/.env`). Backlog P2.25 / P2.28.
#   cp backend/.env.example backend/.env    y reemplazar los valores <...>
# En Docker, MONGO_URL la define docker-compose.yml (con el usuario de la app); la de aquí se
# usa para los scripts (init_rbac.py, seed_data.py) y el backend ejecutado fuera de Docker.

# Conexión desde la máquina local al Mongo de Docker (usuario y contraseña de `.env`):
MONGO_URL=mongodb://boltrex_app:<MONGO_APP_PASSWORD>@localhost:27017/boltrex?directConnection=true&authSource=admin
DB_NAME=boltrex

# Secreto para firmar las sesiones. Generar: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<cadena-larga-aleatoria>

# Contraseña del primer administrador (admin@boltrex.com). Se pide cambiarla al primer ingreso.
ADMIN_INITIAL_PASSWORD=<mínimo 8 caracteres, no admin123>

# --- Opcionales (valores por defecto) ---
# CORS_ORIGINS=http://localhost:3000          # en producción: https://boltrex.online
# ALLOW_PUBLIC_REGISTRATION=false
# PROTECTED_ADMIN_EMAIL=admin@boltrex.com
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_IP_MAX_ATTEMPTS=20
# LOGIN_WINDOW_MINUTES=15
# LOGIN_LOCK_MINUTES=15
# SESSION_IDLE_MINUTES=60
# SESSION_WARNING_MINUTES=5
# ACCESS_TOKEN_EXPIRE_MINUTES=720
# AUDIT_RETENTION_DAYS=180
